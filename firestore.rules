rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation functions
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'email'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.role in ['guru', 'siswa', 'admin'];
    }

    function isValidComic(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidQuizAttempt(data) {
      return data.keys().hasAll(['id', 'userId', 'quizId', 'score', 'completedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.quizId is string && data.quizId.size() <= 128
        && data.score is number
        && data.completedAt is string && data.completedAt.size() <= 50;
    }

    function isValidWritingSubmission(data) {
      return data.keys().hasAll(['id', 'userId', 'taskId', 'content', 'submittedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.taskId is string && data.taskId.size() <= 128
        && data.content is string && data.content.size() <= 10000
        && data.submittedAt is string && data.submittedAt.size() <= 50;
    }

    function isValidSync(data) {
      return data.keys().hasAll(['id', 'version', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.version is number
        && data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // Health / connection test rule
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || existing().email == request.auth.token.email);
      allow list: if isSignedIn() && existing().id == request.auth.uid;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
    }

    // Generated Comics
    match /comics/{comicId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidComic(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Animated Videos
    match /animatedVideos/{videoId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidVideo(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Quiz attempts
    match /quizAttempts/{attemptId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == 'obingmentere04@gmail.com');
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == 'obingmentere04@gmail.com');
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidQuizAttempt(incoming());
    }

    // Writing submissions
    match /writingSubmissions/{submissionId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == 'obingmentere04@gmail.com');
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || request.auth.token.email == 'obingmentere04@gmail.com');
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidWritingSubmission(incoming());
      allow update: if isSignedIn() && isValidWritingSubmission(incoming());
    }

    // Sync State for app snapshot
    match /syncState/{syncId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidSync(incoming());
    }
  }
}
